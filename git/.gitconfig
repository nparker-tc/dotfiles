[maintenance]
	repo = /Users/nathan/Developer/zsh-repos/znap
	repo = /Users/nathan/Developer/zsh-repos/marlonrichert/zsh-autocomplete
[user]
	name = 0x4rch
	# email lives in ~/.gitconfig.local, which is not tracked here

[alias]
    fix = "!f() { ${EDITOR} `git diff --name-only --diff-filter=U`; }; f"

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    theme = dracula

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

# Machine-local overrides (identity, work paths). Missing file is ignored.
[include]
	path = ~/.gitconfig.local
